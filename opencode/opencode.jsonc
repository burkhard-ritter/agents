{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "eu-central-1",
      },
    },
  },
  // Disable built-in bash tool — use run_code instead
  "permission": {
    "bash": "deny",
  },
  "mcp": {
    "weclapp": {
      "type": "local",
      // OpenCode spawns this process and communicates via stdio (MCP protocol).
      // The server also binds an HTTP listener on WECLAPP_MCP_PORT for run_code access.
      "command": [
        "/home/burkhard/.deno/bin/deno",
        "run",
        "--allow-read=/home/burkhard/.weclapp/credentials",
        "--allow-net=sportident.weclapp.com,127.0.0.1",
        "--allow-env=HOME,WECLAPP_MCP_PORT",
        "/home/burkhard/.config/opencode/mcp/weclapp/server.ts",
      ],
      "environment": {
        "WECLAPP_MCP_PORT": "9876",
      },
      "enabled": true,
    },
  },
}
